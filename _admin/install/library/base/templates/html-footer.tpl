
		</main>

		[template /templates/theme.footer]

		<div class="nino-preloader"></div>

		<div class="nino-cookie-banner" id="cookie-banner">
			<p>[[/cookiebanner/info/text]] <a href="[[/website/legal/uri]]">[[/cookiebanner/label/legal]]</a></p>
			<div class="nino-cookie-banner-actions">
				<button type="button" class="nino-btn nino-btn--outline nino-btn--small" data-cookie-consent="declined">[[/cookiebanner/label/decline]]</button>
				<button type="button" class="nino-btn nino-btn--primary nino-btn--small" data-cookie-consent="accepted">[[/cookiebanner/label/accept]]</button>
			</div>
		</div>

		[jstext]
		[assets /.cache/script.js]
	</body>
</html>
