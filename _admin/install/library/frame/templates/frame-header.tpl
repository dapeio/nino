<header class="site-header">
	<div class="wrap">
		[link class="brand" aria-label="[[/project/company/general/name]]" title="[[/_nino/webpage/home/name]]"][imagevalues /logo]<img class="brand-light" src="[[src]]" width="[[width]]" height="[[height]]" alt="">[imagevalues /logo/dark]<img class="brand-dark" src="[[src]]" width="[[width]]" height="[[height]]" alt="">[/imagevalues][else][imagevalues /logo/dark]<img class="brand-dark" src="[[src]]" width="[[width]]" height="[[height]]" alt="">[else]<span>[[/project/company/general/name]]</span>[/imagevalues][/imagevalues][/link]
		<nav class="site-nav" aria-label="[[/template/frame-header/navigation/label]]">
			<details>
				<summary><span class="nino-sr-only">[[/template/frame-header/navigation/menu]]</span></summary>
				<ul>
					<li>[link][[/_nino/webpage/home/name]][/link]</li>
					<li>[link /_nino/webpage/contact/uri][[/_nino/webpage/contact/name]][/link]</li>
				</ul>
			</details>
		</nav>
		[link /_nino/webpage/contact/uri class="button"][[/template/frame-header/header/button]][/link]
	</div>
</header>
