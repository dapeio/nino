<!-- nino:template-name Services -->
[template /templates/html-header]
<div class="nino-wrap">

<section id="intro" class="nino-section nino-text-center">
	<div class="nino-grid-row nino-grid-row--full nino-pl-0 nino-pr-0">
		<div class="nino-grid-100">
			[title /template/page-services/intro/title tag="h2"]
			[subtitle /template/page-services/intro/text tag="p"]
		</div>
	</div>
</section>

<section id="items" class="nino-section">
	<div class="nino-grid-row">
		<div class="nino-grid-100 nino-grid-l-33 nino-text-left">
			[title /template/page-services/item-1/title]
			[text /template/page-services/item-1/text format="inline"]
		</div>
		<div class="nino-grid-100 nino-grid-l-33 nino-text-left">
			[title /template/page-services/item-2/title]
			[text /template/page-services/item-2/text format="inline"]
		</div>
		<div class="nino-grid-100 nino-grid-l-33 nino-text-left">
			[title /template/page-services/item-3/title]
			[text /template/page-services/item-3/text format="inline"]
		</div>
	</div>
</section>

</div>
[template /templates/html-footer]
