		<footer class="nino-frame-footer">
			<section class="nino-frame-footer-content">
				<div class="nino-grid-row">
					<div class="nino-grid-100 nino-grid-l-50">
						<img src="[[/nino/public]]/images/logo.png" class="nino-footer-logo" alt="[[/company/name]]">
					</div>
					<address class="nino-grid-100 nino-grid-m-50 nino-grid-l-25 nino-frame-footer-contact">
						<h2>[[/website/footer/title/getintouch]]</h2>
						<p>[[/company/adress]]<br>[[/company/country]]</p>
						<p>[[/company/phone]]<br>[[/company/email]]</p>
					</address>
					<nav class="nino-grid-100 nino-grid-m-50 nino-grid-l-25 nino-frame-footer-nav" aria-label="[[/website/footer/title/navigation]]">
						[template /templates/html-footer-nav]
					</nav>
				</div>
			</section>
			<section class="nino-frame-footer-legal">
				<div class="nino-grid-row">
					<div class="nino-grid-100 nino-grid-l-33">
						<p>&copy; [[/date/year]] [[/company/name]]</p>
					</div>
					<div class="nino-grid-100 nino-grid-l-33">
						[template /templates/html-footer-legal]
					</div>
					<div class="nino-grid-100 nino-grid-l-33">
						[template /templates/html-footer-localepicker]
					</div>
				</div>
			</section>
		</footer>
