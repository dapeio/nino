		<footer class="nino-frame-footer">
			<div class="nino-frame-footer-split">
				<section class="nino-frame-footer-panel nino-frame-footer-panel--brand">
					<img src="[[/nino/public]]/images/logo-invert.png" class="nino-footer-logo" alt="[[/company/name]]">
					<p>[[/company/description]]</p>
				</section>
				<section class="nino-frame-footer-panel nino-frame-footer-panel--info">
					<address class="nino-frame-footer-contact">
						<h2 class="nino-footer-title">[[/website/footer/title/getintouch]]</h2>
						<p>[[/company/adress]]<br>[[/company/country]]</p>
						<p>[[/company/phone]]<br>[[/company/email]]</p>
					</address>
					<nav class="nino-frame-footer-nav" aria-label="[[/website/footer/title/navigation]]">
						[template /templates/html-footer-nav]
					</nav>
				</section>
			</div>
			<div class="nino-grid-row">
				<div class="nino-grid-100 nino-frame-footer-legal">
					<p>&copy; [[/date/year]] [[/company/name]]</p>
					<div class="nino-frame-footer-utility">
						[template /templates/html-footer-legal]
						[template /templates/html-footer-localepicker]
					</div>
				</div>
			</div>
		</footer>
