index 8707449..0000000
--- a/_install/library/themes/surface/assets/style.theme.surface.css
+++ /dev/null
@@ -1,259 +0,0 @@
-@font-face {
-	font-family: 'Text';
-	font-style: normal;
-	font-weight: normal;
-	font-display: swap;
-	src: local('Text Regular'), url('[[/nino/public]]/fonts/roboto-regular.woff2') format('woff2');
-}
-@font-face {
-	font-family: 'Text';
-	font-style: normal;
-	font-weight: bold;
-	font-display: swap;
-	src: local('Text Bold'), url('[[/nino/public]]/fonts/roboto-bold.woff2') format('woff2');
-}
-@font-face {
-	font-family: 'Title';
-	font-style: normal;
-	font-weight: bold;
-	font-display: swap;
-	src: local('Title Bold'), url('[[/nino/public]]/fonts/outfit.woff2') format('woff2');
-}
-
-/*	Surface.
-
-	Large tonal areas, wide margins and light that falls from one side - the
-	page is built from surfaces that lie on each other rather than from lines
-	that separate them. For product sites, apps and anything that should read
-	as current.
-
-	Colours here are assignments, never values. /_design generates the --nino-*
-	tokens this file reads (assets/style.design.css, loaded immediately before
-	it) and measures every background/text pair it publishes; what this unit
-	decides is which surface each role sits on. Recolouring the site is
-	therefore a /_design save and nothing below has to change.
-
-	Three rules follow. Never write a literal colour into a role - a hex here
-	is a pair /_design cannot vouch for. Never pair across surfaces, because
-	--color-section-alt-text belongs to --nino-on-alt and to nothing else. And
-	never put text on --nino-brand or --nino-accent: those are the two brand
-	colours exactly as they were picked, so they are the surfaces with no
-	contrast promise attached - --nino-brand-safe and --nino-accent-safe are the
-	same two colours made safe, and those are what carry ink.	*/
-:root {
-
-	/* Brand. Four roles from two questions - is it the first brand colour or the
-	   second, and is it the one that was picked or the one text survives on.
-	   --color-secondary is the primary exactly as it was picked and is only ever
-	   shown; --color-primary is that same colour with its lightness solved until
-	   the text on it clears the contrast target, and is what every button and
-	   filled surface uses. --color-brand-alt is the second colour playing the
-	   same part as --color-primary: filled with, written on, and safe.
-
-	   The palette used to publish one safe surface for whichever of the two
-	   colours had been settled on, so setting a Secondary quietly moved every
-	   button onto it and left no contrast-safe brand anywhere. Naming both is
-	   what lets a look use two colours instead of choosing between them. */
-	--color-primary: var(--nino-brand-safe);
-	--color-primary-text: var(--nino-on-brand-safe);
-	/*	A product palette marks the chosen thing in a colour that is not the
-		one every button already carries - the featured plan, the active slide.
-		Triadic by the manifest, so it is a real second colour. */
-	--color-secondary: var(--nino-accent);
-	--color-brand-alt: var(--nino-accent-safe);
-	--color-brand-alt-text: var(--nino-on-accent-safe);
-
-	/* ...and the brand as ink, which is a third value again: --color-primary
-	   is solved so text survives *on* it, and says nothing about what it does
-	   written on a page surface. Every ground gets the one /_design solved for
-	   it, so a price, a stat, an outline button or an info alert clears the
-	   text target wherever it lands */
-	--color-accent-default: var(--nino-default-link);
-	--color-accent-alt: var(--nino-alt-link);
-	--color-accent-tint: var(--nino-tint-link);
-	--color-accent-dark: var(--nino-dark-link);
-	--color-accent-black: var(--nino-black-link);
-
-
-	/* ...and the focus ring, which is the same role again with a different
-	   target: 3:1 rather than 4.5, per WCAG 2.2 SC 1.4.11. Each ground takes
-	   the ring solved for the surface it actually paints - the line above it
-	   names that surface, and a ring solved against a different one is the
-	   cross-surface pairing this whole split exists to prevent */
-	--color-focus-default: var(--nino-default-focus);
-	--color-focus-alt: var(--nino-alt-focus);
-	--color-focus-tint: var(--nino-tint-focus);
-	--color-focus-dark: var(--nino-dark-focus);
-	--color-focus-black: var(--nino-black-focus);
-
-	/* The one role that is meant to fail the text target - see Nino.css.
-	   Solved against the page ground, which is where a form sits */
-	--color-disabled: var(--nino-default-disabled);
-
-	/* Page ground */
-	--color-background: var(--nino-default);
-	--color-text: var(--nino-on-default);
-	--color-title: var(--nino-on-default);
-	--color-subtitle: var(--nino-on-default-muted);
-	--color-border: var(--nino-default-border);
-	/*	The floating header is a surface like the cards under it, so it takes
-		a ground of its own rather than the page's - tinted, which is the one
-		step available that is not another grey */
-	--color-header-bg: var(--nino-tint);
-
-	/* The scrim over a cover image - not a pair /_design can solve, since
-	   it cannot know the photograph underneath, so the theme derives it
-	   from its deepest surface and owns the light text put on top */
-	--color-background-dim: color-mix(in srgb, var(--nino-black) 72%, transparent);
-
-	/* Footer bands. The main band is the brand surface this theme is named
-	   for; the legal line steps down to the tone below it rather than to a
-	   line, which is the same idea one layer further down */
-	--color-footer-bg-main: var(--nino-brand-safe);
-	--color-footer-text-main: var(--nino-on-brand-safe);
-	--color-footer-bg-legal: var(--nino-brand-safe);
-	--color-footer-text-legal: var(--nino-on-brand-safe-muted);
-	--color-footer-text: var(--nino-on-brand-safe);
-
-	/* Sections - the four grounds a page alternates between */
-	--color-section-default-bg: var(--nino-default);
-	--color-section-default-text: var(--nino-on-default);
-	--color-section-alt-bg: var(--nino-alt);
-	--color-section-alt-text: var(--nino-on-alt);
-	/*	The fifth ground: the page with the brand in it rather than a near-grey
-		step away from it. Quiet enough to read a whole section on, coloured
-		enough to read as chosen. */
-	--color-section-tint-bg: var(--nino-tint);
-	--color-section-tint-text: var(--nino-on-tint);
-	--color-section-dark-bg: var(--nino-dark);
-	--color-section-dark-text: var(--nino-on-dark);
-	--color-section-black-bg: var(--nino-black);
-	--color-section-black-text: var(--nino-on-black);
-
