# Editor defaults for Nino - matches the existing source: tabs everywhere,
# LF line endings, UTF-8, no trailing whitespace. Markdown keeps trailing
# spaces (two of them are a hard line break there).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{yml,yaml,json,neon,webmanifest}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
