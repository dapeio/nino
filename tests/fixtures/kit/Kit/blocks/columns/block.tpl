			[band-title ~title]
			[prose ~text]
		[/band-col]
	[/band-row]
	[band-row]
		[band-col id="cols-a" size="100 m:33" variant="card"]
			[band-title ~title tag="h3" size="s"]
			[prose ~text]
		[/band-col]
		[band-col id="cols-b" size="100 m:33" variant="card"]
			[band-title ~title tag="h3" size="s"]
			[prose ~text]
		[/band-col]
		[band-col id="cols-c" size="100 m:33" variant="card"]
			[band-title ~title tag="h3" size="s"]
			[prose ~text]
		[/band-col]
	[/band-row]
[/band-wrap]