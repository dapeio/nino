[band-wrap id="split" ground="base"]
	[band-row gap="3" valign="center"]
		[band-col size="100 m:50"]
			[pic ~picture ratio="4-3" alt="~alt"]
		[/band-col]
		[band-col size="100 m:50"]
			[band-title ~title]
			[prose ~text]
			[lever ~button href="~link" tone="quiet"]
		[/band-col]
	[/band-row]
[/band-wrap]