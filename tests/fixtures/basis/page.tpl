[header-wrap id="top" sticky][header-logo][header-nav][header-actions][button ~signin href="page:/contact" size="s"][/header-actions][/header-wrap]
<main id="main">
	[section-wrap id="hero" ground="dark" image="~background" dim height="60"]
		[section-row width="narrow" valign="center"]
			[section-col align="center"]
				[section-title ~title tag="h1" size="xl"]
				[section-subtitle ~subtitle]
				[button-group align="center"]
					[button ~start href="page:/contact" size="l"]
					[button ~more href="#cards" tone="quiet" size="l"]
				[/button-group]
			[/section-col]
		[/section-row]
	[/section-wrap]
	[section-wrap id="cards" ground="alt"]
		[section-row]
			[section-col]
				[section-title ~heading]
			[/section-col]
		[/section-row]
		[section-row gap="3"]
			[section-col id="card-1" size="100 m:33" variant="card" bleed]
				[image ~photo ratio="16-9" focus="top-left" alt="~alt"]
				[section-title ~title tag="h3" size="s"]
				[text ~text size="s"]
			[/section-col]
			[section-col id="card-2" size="100 m:33" variant="card" ground="tint" pad="3"]
				[section-title ~title tag="h3" size="s"]
				[text ~text]
				[button ~more href="https://example.test/docs" target="blank" tone="quiet"]
			[/section-col]
			[section-col id="card-3" size="100 m:33" variant="card" link]
				[section-title ~title tag="h3" size="s" href="page:/about"]
				[text ~text]
				[button ~more href="page:/contact" size="s"]
			[/section-col]
		[/section-row]
	[/section-wrap]
	[section-wrap id="story"]
		[section-row valign="center" reverse="off m:on"]
			[section-col size="100 m:50"]
				[section-title ~title]
				[text ~text]
				[spacer size="3"]
				[text ~address format="lines" size="l"]
				[button ~link href="javascript:alert(1)"]
			[/section-col]
			[section-col size="100 m:50" align="center"]
				[image ~photo ratio="4-3" alt="~alt" caption="~caption" href="page:/contact"]
				[image ~photo ratio="21-9" decorative href="page:/contact"]
				[html]<p>Eine Zeile in <strong>Markup</strong>, mit einem <a href="https://example.test/">Link</a>.</p><ul><li>Eins</li><li>Zwei</li></ul>[/html]
			[/section-col]
		[/section-row]
	[/section-wrap]
	[section-wrap id="picture" image="~background"]
		[section-row width="narrow"]
			[section-col align="center"]
				[section-title ~title tag="h2" size="l"]
				[section-subtitle ~subtitle]
				[button-group align="center"][button ~start href="page:/contact"][button ~more href="#cards" tone="quiet"][/button-group]
			[/section-col]
		[/section-row]
	[/section-wrap]
	[section-wrap id="join" ground="primary"]
		[section-row width="narrow"]
			[section-col align="center" hide="off l:off"]
				[section-title ~title size="l"]
				[button ~button href="page:/contact" wide]
			[/section-col]
		[/section-row]
	[/section-wrap]
</main>
[footer-wrap id="bottom"][footer-col size="100 m:50"][footer-logo /logo alt="~alt"][text ~about size="s"][/footer-col][footer-col size="100 m:25"][footer-nav menu="main" label="~navmain"][/footer-col][footer-col size="100 m:25"][footer-nav menu="footer" label="~navmore"][button ~contact href="page:/contact" size="s"][/footer-col][footer-legal][/footer-wrap]
