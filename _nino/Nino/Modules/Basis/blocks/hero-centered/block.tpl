[section-wrap id="hero" ground="primary" height="80"]
	[section-row width="narrow" valign="center"]
		[section-col align="center"]
			[section-title ~title tag="h1" size="xl"]
			[section-subtitle ~subtitle]
			[button-group align="center"]
				[button ~button href="~link" size="l"]
				[button ~second href="~second-link" tone="quiet" size="l"]
			[/button-group]
		[/section-col]
	[/section-row]
[/section-wrap]