[section-wrap id="split" ground="base"]
	[section-row gap="3" valign="center"]
		[section-col size="100 m:50"]
			[image ~picture ratio="4-3" alt="~alt"]
		[/section-col]
		[section-col size="100 m:50"]
			[section-title ~title]
			[text ~text]
			[button ~button href="~link" tone="quiet"]
		[/section-col]
	[/section-row]
[/section-wrap]