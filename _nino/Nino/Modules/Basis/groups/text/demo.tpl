[section-wrap ground="base"]
	[section-row]
		[section-col size="50"]
			[text size="s" text="<p>A text in the small size. A paragraph is followed by a second one, and the room between them is the gap between paragraphs.</p><p>The second paragraph of the small text.</p>"]
			[spacer size="2"]
			[text size="m" text="<p>A text in the medium size, which is the standard. It has paragraphs and a list.</p><p>The second paragraph of the medium text.</p><ul><li>The first entry of a list</li><li>The second entry</li></ul>"]
		[/section-col]
		[section-col size="50"]
			[text size="l" text="<p>A text in the large size. The room between a paragraph and the next one.</p><p>The second paragraph of the large text.</p><p>And a third one.</p>"]
			[spacer size="4"]
			[html]<p>Markup of the page, as <strong>html</strong> keeps it.</p><p>A second paragraph of the markup.</p>[/html]
		[/section-col]
	[/section-row]
[/section-wrap]
