[section-wrap ground="base"]
	[section-row]
		[section-col]
			[section-title tag="h2" size="l" text="A section"]
			[section-subtitle text="A title and a subtitle, rows with columns, and cards: the space above and below, the gap between the columns, the card and the space below a title."]
		[/section-col]
	[/section-row]
	[section-row gap="2"]
		[section-col size="50" variant="card" ground="tint" pad="3"]
			[section-title tag="h3" size="s" text="Gap 2, padding 3"]
			[text size="s" text="A large padding."]
		[/section-col]
		[section-col size="50" variant="card" ground="tint" pad="4"]
			[section-title tag="h3" size="s" text="Gap 2, padding 4"]
			[text size="s" text="The largest."]
		[/section-col]
	[/section-row]
	[section-row gap="1"]
		[section-col size="50" variant="card" ground="tint" pad="1"]
			[section-title tag="h3" size="s" text="Gap 1, padding 1"]
			[text size="s" text="A small padding."]
		[/section-col]
		[section-col size="50" variant="card" ground="tint" pad="2"]
			[section-title tag="h3" size="s" text="Gap 1, padding 2"]
			[text size="s" text="A little more."]
		[/section-col]
	[/section-row]
	[section-row gap="0"]
		[section-col size="50" variant="card" ground="tint" pad="auto"]
			[section-title tag="h3" size="s" text="Gap 0, padding auto"]
			[text size="s" text="A card with the standard padding."]
		[/section-col]
		[section-col size="50" variant="card" ground="tint" pad="0"]
			[section-title tag="h3" size="s" text="Gap 0, padding 0"]
			[text size="s" text="A card with none."]
		[/section-col]
	[/section-row]
[/section-wrap]
[section-wrap ground="alt"]
	[section-row gap="3"]
		[section-col size="50" variant="card" ground="base" pad="auto"]
			[section-title tag="h3" size="s" text="Gap 3"]
			[section-subtitle text="A subtitle under a title."]
			[text size="s" text="The space below a title and a subtitle is the same as the space between a card and what it holds."]
		[/section-col]
		[section-col size="50" variant="card" ground="base" pad="auto"]
			[section-title tag="h3" size="s" text="Gap 3"]
			[section-subtitle text="Another subtitle."]
			[text size="s" text="Two cards of one row stand as far apart as the gap says."]
		[/section-col]
	[/section-row]
	[section-row gap="4"]
		[section-col size="50"]
			[section-title tag="h3" size="m" text="Gap 4, a column"]
			[text text="A column that is no card has no surface of its own."]
		[/section-col]
		[section-col size="50"]
			[section-title tag="h3" size="m" text="Gap 4, a column"]
			[text text="The two stand as far apart as the gap of their row."]
		[/section-col]
	[/section-row]
	[section-row halign="center" gap="3"]
		[section-col size="50 m:20"]
			[section-title tag="h3" size="s" text="A fifth"]
		[/section-col]
		[section-col size="50 m:20"]
			[section-title tag="h3" size="s" text="A fifth"]
		[/section-col]
		[section-col size="50 m:16"]
			[section-title tag="h3" size="s" text="A sixth, a link" href="#"]
		[/section-col]
	[/section-row]
[/section-wrap]
[section-wrap ground="tint" image="/nino/placeholder/landscape" picture="off"]
	[section-row]
		[section-col]
			[section-title tag="h3" size="m" text="A section with its picture hidden"]
			[text text="The picture stays named in the call and is not drawn; the ground shows."]
		[/section-col]
	[/section-row]
[/section-wrap]
