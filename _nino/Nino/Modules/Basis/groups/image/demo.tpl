[section-wrap ground="base"]
	[section-row]
		[section-col]
			[section-title tag="h2" size="m" text="Images"]
			[section-subtitle text="Pictures of different shapes, with and without a caption, fitted or cropped, of a fixed height: the radius of the corners and the height of a step."]
		[/section-col]
	[/section-row]
	[section-row]
		[section-col size="100 m:50"]
			[image /nino/placeholder/landscape ratio="4-3" decorative caption="A picture of 4 to 3, with a caption"]
		[/section-col]
		[section-col size="50 m:25"]
			[image /nino/placeholder/landscape ratio="1-1" focus="right" decorative]
		[/section-col]
		[section-col size="50 m:25"]
			[image /nino/placeholder/landscape ratio="3-4" focus="left" decorative]
		[/section-col]
	[/section-row]
	[section-row]
		[section-col]
			[image /nino/placeholder/landscape ratio="21-9" decorative caption="A wide picture, 21 to 9"]
		[/section-col]
	[/section-row]
	[section-row halign="center" valign="end"]
		[section-col size="50 m:20" align="center"]
			[image /nino/placeholder/landscape height="1" decorative caption="Height 1"]
		[/section-col]
		[section-col size="50 m:20" align="center"]
			[image /nino/placeholder/landscape height="2" decorative caption="Height 2"]
		[/section-col]
		[section-col size="50 m:20" align="center"]
			[image /nino/placeholder/landscape height="3" decorative caption="Height 3"]
		[/section-col]
		[section-col size="50 m:20" align="center"]
			[image /nino/placeholder/landscape height="4" decorative caption="Height 4"]
		[/section-col]
	[/section-row]
	[section-row halign="center"]
		[section-col size="50 m:25"]
			[image /nino/placeholder/landscape ratio="1-1" decorative caption="1 to 1, cropped"]
		[/section-col]
		[section-col size="50 m:25"]
			[image /nino/placeholder/landscape ratio="1-1" fit decorative caption="1 to 1, fitted"]
		[/section-col]
	[/section-row]
[/section-wrap]
