[section-wrap ground="base"]
	[section-row]
		[section-col]
			[section-title tag="h2" size="m" text="Images"]
			[section-subtitle text="Pictures of different shapes, with and without a caption: the radius of the corners."]
		[/section-col]
	[/section-row]
	[section-row]
		[section-col size="100 m:50"]
			[image /nino/placeholder/landscape ratio="4-3" decorative caption="A picture of 4 to 3, with a caption"]
		[/section-col]
		[section-col size="50 m:25"]
			[image /nino/placeholder/landscape ratio="1-1" focus="right" decorative]
		[/section-col]
		[section-col size="50 m:25"]
			[image /nino/placeholder/landscape ratio="3-4" focus="left" decorative]
		[/section-col]
	[/section-row]
	[section-row]
		[section-col]
			[image /nino/placeholder/landscape ratio="21-9" decorative caption="A wide picture, 21 to 9"]
		[/section-col]
	[/section-row]
[/section-wrap]
