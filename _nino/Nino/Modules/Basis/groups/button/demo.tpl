[section-wrap ground="base"]
	[section-row]
		[section-col]
			[section-title tag="h2" size="m" text="Buttons"]
			[section-subtitle text="Every tone and every size: the padding, the radius and the font size of a button."]
			[button-group align="start"]
				[button href="#" tone="primary" size="s" text="Primary, small"]
				[button href="#" tone="primary" size="m" text="Primary, medium"]
				[button href="#" tone="primary" size="l" text="Primary, large"]
			[/button-group]
			[button-group align="start"]
				[button href="#" tone="quiet" size="s" text="Quiet, small"]
				[button href="#" tone="quiet" size="m" text="Quiet, medium"]
				[button href="#" tone="quiet" size="l" text="Quiet, large"]
			[/button-group]
			[button-group align="center"]
				[button href="#" wide text="Full width"]
				[button text="Without an address"]
			[/button-group]
		[/section-col]
	[/section-row]
[/section-wrap]
