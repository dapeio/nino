[section-wrap ground="base"]
	[section-row]
		[section-col]
			[section-title tag="h2" size="m" text="Buttons"]
			[section-subtitle text="Every weight - main, second colour, outline, quiet - and every size: the padding, the radius and the font size of a button."]
			[button-group align="start"]
				[button href="#" tone="primary" size="s" text="Primary, small"]
				[button href="#" tone="primary" size="m" text="Primary, medium"]
				[button href="#" tone="primary" size="l" text="Primary, large"]
			[/button-group]
			[button-group align="start"]
				[button href="#" tone="secondary" size="s" text="Second colour, small"]
				[button href="#" tone="secondary" size="m" text="Second colour, medium"]
				[button href="#" tone="secondary" size="l" text="Second colour, large"]
			[/button-group]
			[button-group align="start"]
				[button href="#" tone="outline" size="s" text="Outline, small"]
				[button href="#" tone="outline" size="m" text="Outline, medium"]
				[button href="#" tone="outline" size="l" text="Outline, large"]
			[/button-group]
			[button-group align="start"]
				[button href="#" tone="quiet" size="s" text="Quiet, small"]
				[button href="#" tone="quiet" size="m" text="Quiet, medium"]
				[button href="#" tone="quiet" size="l" text="Quiet, large"]
			[/button-group]
			[button-group align="center"]
				[button href="#" wide text="Full width"]
				[button text="Without an address"]
			[/button-group]
		[/section-col]
	[/section-row]
[/section-wrap]

[section-wrap ground="dark"]
	[section-row]
		[section-col]
			[section-title tag="h2" size="m" text="Buttons on a dark ground"]
			[button-group align="start"]
				[button href="#" tone="primary" text="Main"]
				[button href="#" tone="secondary" text="Second colour"]
				[button href="#" tone="outline" text="Outline"]
				[button href="#" tone="quiet" text="Quiet"]
			[/button-group]
		[/section-col]
	[/section-row]
[/section-wrap]
