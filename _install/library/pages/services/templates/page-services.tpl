[template /templates/html-header]
<section class="nino-section nino-section--fullwidth nino-text-center">
	<div class="nino-grid-row">
		<div class="nino-grid-100">
			<h2 class="nino-section-title">[[/page-services/title]]</h2>
			<p class="nino-section-subtitle">[[/page-services/intro]]</p>
		</div>
	</div>
</section>
<section class="nino-section">
	<div class="nino-grid-row">
		<div class="nino-grid-100 nino-grid-l-33">
			<h3>[[/page-services/item/1/title]]</h3>
			<p>[[/page-services/item/1/text]]</p>
		</div>
		<div class="nino-grid-100 nino-grid-l-33">
			<h3>[[/page-services/item/2/title]]</h3>
			<p>[[/page-services/item/2/text]]</p>
		</div>
		<div class="nino-grid-100 nino-grid-l-33">
			<h3>[[/page-services/item/3/title]]</h3>
			<p>[[/page-services/item/3/text]]</p>
		</div>
	</div>
</section>
[template /templates/html-footer]
