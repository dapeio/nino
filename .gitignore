/_admin/.cache/

# The project's private half - all of it. A checkout ships no private/ at
# all: the wizard creates the directory, brings its own deny rule with it
# (_admin/install/library/base/private/.htaccess) and writes the first config.php
# at the end of its Setup step. Nothing in here is repository content -
# it is one installation's configuration, its pages and text, the data its
# visitors produce, and management state holding PII and credentials
/private/

# The project's public half - everything a browser loads directly. All of it
# is the wizard's output (fonts, the favicon set, the generated css/js bundles)
# or runtime content (uploaded images), never repository content
/public/

# The installed features - catalogue content, one directory per feature,
# never repository content (see \Nino\Features and docs/features.md). Its
# deny rule is the exception: that file is this repository's and a checkout
# has to carry it, so the exclusion names the contents rather than the
# directory. As a directory exclusion this was one `git rm` away from
# being unrecoverable - git stops at an excluded directory and never reads
# what is inside, so a deleted deny rule could not be added back
/features/*
!/features/.htaccess

.DS_Store
Thumbs.db

# Patches are handed around, never versioned - the change itself is
*.patch
